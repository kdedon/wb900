InstallClipRegion(layer,region)(struct Layer *,struct Region *) struct Region * @Layers_29
MoveSizeLayer(layer,dx,dy,dw,dh)(struct Layer *,LONG,LONG,LONG,LONG) LONG @Layers_30
CreateUpfrontHookLayer(li,bm,x0,y0,x1,y1,flags,hook,bm2)(struct Layer_Info *,struct BitMap *,LONG,LONG,LONG,LONG,LONG,struct Hook *,struct BitMap *) struct Layer * @Layers_31
CreateBehindHookLayer(li,bm,x0,y0,x1,y1,flags,hook,bm2)(struct Layer_Info *,struct BitMap *,LONG,LONG,LONG,LONG,LONG,struct Hook *,struct BitMap *) struct Layer * @Layers_32
InstallLayerHook(layer,hook)(struct Layer *,struct Hook *) struct Hook * @Layers_33
InstallLayerInfoHook(li,hook)(struct Layer_Info *,struct Hook *) struct Hook * @Layers_34
SortLayerCR(layer,dx,dy)(struct Layer *,LONG,LONG) void @Layers_35
DoHookClipRects(hook,rport,rect)(struct Hook *,struct RastPort *,struct Rectangle *) void @Layers_36
ChangeLayerShape(l,newshape,callback)(struct Layer *,struct Region *,struct Hook *) struct Region * @Layers_37
ScaleLayer(l,taglist)(a0,a1)
CreateUpfrontLayerTagList(li,bm,x0,y0,x1,y1,flags,tagList)(struct Layer_Info *,struct BitMap *,LONG,LONG,LONG,LONG,LONG,struct TagItem *) struct Layer * @Layers_39
CreateBehindLayerTagList(li,bm,x0,y0,x1,y1,flags,tagList)(struct Layer_Info *,struct BitMap *,LONG,LONG,LONG,LONG,LONG,struct TagItem *) struct Layer * @Layers_40
