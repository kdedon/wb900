EndUpdate(layer,flag)(struct Layer *,UWORD) void @Layers_14
DeleteLayer(dummy,layer)(LONG,struct Layer *) LONG @Layers_15
LockLayer(dummy,layer)(LONG,struct Layer *) void @Layers_16
